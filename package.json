{
  "name": "aifirst",
  "version": "0.1.0",
  "description": "Companion CLI for the AI First book series. Installs book skills into Claude Code, Codex, Antigravity and VS Code, serves the book's canonical answers, and keeps a learner log.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aifirstprogramming/aifirstcli.git"
  },
  "homepage": "https://aifirstprogramming.com",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "sync-content": "bun scripts/sync-content.ts",
    "build": "bun scripts/build.ts",
    "build:local": "bun scripts/build.ts --local",
    "check": "bun scripts/sync-content.ts --check && tsc -p tsconfig.json && bun test"
  },
  "dependencies": {
    "@aifirst/content": "file:../aifirstcontent"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.19.41",
    "typescript": "^5.8.3"
  }
}
