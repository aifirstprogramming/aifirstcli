{
  "name": "aifirst",
  "version": "0.10.0",
  "description": "Companion CLI for the AI First book series. Installs book skills into Claude Code, Codex, Antigravity and VS Code, serves the book's canonical answers, and keeps a learner log.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aifirstprogramming/aifirstcli.git"
  },
  "homepage": "https://aifirstprogramming.com",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "sync-content": "bun scripts/sync-content.ts",
    "build": "bun scripts/build.ts",
    "build:local": "bun scripts/build.ts --local",
    "capture:claude-e2e": "bun scripts/capture-claude-showtail-e2e.ts",
    "explore:learn": "bun scripts/explore-learn.ts",
    "explore:learn:pr": "bun scripts/explore-learn.ts --profile pr",
    "explore:learn:full": "bun scripts/explore-learn.ts --profile full",
    "explore:learn:native": "bun scripts/explore-native-learn.ts",
    "test:learn:live": "bun test test/duckling-learn-live.test.ts test/chapter10-learn-live.test.ts test/learn-confirmation-live.test.ts test/learn-interactive-regression.test.ts test/replay-learn-regression.test.ts",
    "check": "bun scripts/sync-content.ts --check && tsc -p tsconfig.json && bun test"
  },
  "//dependencies": [
    "Pinned to an exact content commit rather than a sibling path so `bun install` works in CI and",
    "on a fresh clone. For local content work, run `bun link` in an aifirstcontent",
    "checkout and `bun link @aifirst/content` here."
  ],
  "dependencies": {
    "@aifirst/content": "github:aifirstprogramming/aifirstcontent#v1.7.0",
    "@opentui/core": "0.5.10",
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "marked": "18.0.11",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.19.41",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.5.10",
    "@opentui/core-darwin-x64": "0.5.10",
    "@opentui/core-linux-arm64": "0.5.10",
    "@opentui/core-linux-arm64-musl": "0.5.10",
    "@opentui/core-linux-x64": "0.5.10",
    "@opentui/core-linux-x64-musl": "0.5.10",
    "@opentui/core-win32-arm64": "0.5.10",
    "@opentui/core-win32-x64": "0.5.10"
  }
}
