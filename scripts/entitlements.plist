<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements required to codesign a Bun-compiled binary on macOS.

  Bun embeds JavaScriptCore, which JIT-compiles at runtime. Without these the
  signed binary is killed on launch. Required per Bun's single-file executable
  documentation.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.disable-executable-page-protection</key>
  <true/>
</dict>
</plist>
